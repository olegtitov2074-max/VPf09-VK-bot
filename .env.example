# Токен сообщества VK (группы), с правами на сообщения
VK_TOKEN=ваш_токен_сообщества

# ID сообщества VK
GROUP_ID=123456789

# API-ключ ProxyAPI.ru (Gemini)
GEMINI_API_KEY=ваш_ключ_proxyapi

# Модель Gemini (можно менять)
GEMINI_MODEL=gemini-3.5-flash-lite

# Базовый URL ProxyAPI для Gemini
GEMINI_BASE_URL=https://api.proxyapi.ru/google

# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

AI_API_KEY=
AI_BASE_URL=https://api.proxyapi.ru/openai/v1
AI_MODEL=gpt-4.1-mini